generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  GUIDE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tour {
  id          String    @id @default(cuid())
  name        String
  date        DateTime  @db.Date
  guideName   String?
  managerName String?
  color       String    @default("#6366f1")
  sortOrder   Int       @default(0)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([managerName])
}

model Booking {
  id           String    @id @default(cuid())
  tourId       String
  tour         Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotel        String
  room         String?
  guestName    String
  adults       Int       @default(1)
  children     Int       @default(0)
  phone        String?
  pickupTime   String?
  costUsd      Decimal?  @db.Decimal(10, 2)
  deposit      String?
  balanceUsd   String?
  balanceVnd   String?
  hotelAddress String?   @db.Text
  billNumber   String?
  managerName  String?
  remark       String?   @db.Text
  notes        String?   @db.Text
  isCancelled  Boolean   @default(false)
  cancelledAt  DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tourId])
  @@index([isCancelled])
  @@index([managerName])
}
